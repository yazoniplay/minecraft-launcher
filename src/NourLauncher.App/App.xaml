<Application x:Class="NourLauncher.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="SkyBackground" Color="#111C28"/>
  <SolidColorBrush x:Key="SkySurface" Color="#1F2D3B"/>
  <SolidColorBrush x:Key="SkyBlue" Color="#3D8EDB"/>
  <SolidColorBrush x:Key="SkyText" Color="#F2F7FC"/>
  <SolidColorBrush x:Key="SkyMuted" Color="#A8B8C8"/>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Foreground" Value="#EAF4FF"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="12,11"/>
   <Setter Property="Margin" Value="0,2,0,2"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>
 </Application.Resources>
</Application>