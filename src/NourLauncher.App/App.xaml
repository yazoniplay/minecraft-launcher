<Application x:Class="NourLauncher.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="NourBackground" Color="#171B18"/>
  <SolidColorBrush x:Key="NourSurface" Color="#232A24"/>
  <SolidColorBrush x:Key="NourGreen" Color="#6FA35B"/>
  <SolidColorBrush x:Key="NourText" Color="#F0F1E9"/>
  <SolidColorBrush x:Key="NourMuted" Color="#AAB3A7"/>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Foreground" Value="#E5EAE1"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="12,11"/>
   <Setter Property="Margin" Value="0,2,0,2"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>
 </Application.Resources>
</Application>