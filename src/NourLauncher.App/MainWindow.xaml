<Window x:Class="NourLauncher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sky Client" Height="760" Width="1180"
 MinHeight="650" MinWidth="960" WindowStartupLocation="CenterScreen"
 Background="{StaticResource SkyBackground}" Foreground="{StaticResource SkyText}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#172738" Padding="22">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="▰  SKY" FontSize="25" FontWeight="ExtraBold" Foreground="#E2F1FF" Margin="0,4,0,34"/>
     <TextBlock Text="LIBRARY" Foreground="{StaticResource SkyMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
     <Button Content="⌂   Home" Style="{StaticResource NavButton}" Click="Home_Click"/>
     <Button Content="▦   Versions" Style="{StaticResource NavButton}" Click="Versions_Click"/>
     <Button Content="◇   Instances" Style="{StaticResource NavButton}" Click="Instances_Click"/>
     <Button Content="▧   Mods" Style="{StaticResource NavButton}" Click="Mods_Click"/>
     <Button Content="⌁   Diagnostics" Style="{StaticResource NavButton}" Click="Diagnostics_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button Content="♙   Profiles" Style="{StaticResource NavButton}" Click="Profiles_Click"/>
     <Button Content="⚙   Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/>
     <TextBlock Text="SKY CLIENT  ·  ALPHA" Foreground="{StaticResource SkyMuted}" FontSize="10" Margin="2,18,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <Grid Margin="38">
    <StackPanel x:Name="HomePanel">
     <TextBlock Text="YOUR WORLDS AWAIT." FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Welcome to Sky Client." FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="One home for every Minecraft version." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,30"/>
     <Border CornerRadius="12" Background="#1F4D75" Padding="28" Margin="0,0,0,22">
      <StackPanel>
       <TextBlock Text="READY WHEN YOU ARE" Foreground="#D7EAFA" FontSize="11" FontWeight="Bold"/>
       <TextBlock Text="Minecraft, your way." FontSize="27" FontWeight="Bold" Margin="0,8,0,5"/>
       <TextBlock Text="The launcher foundation is in place. Profile management is available now." Foreground="#D7EAFA" TextWrapping="Wrap"/>
       <Button Content="MANAGE PROFILES" Width="170" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="14,9" Click="Profiles_Click"/>
      </StackPanel>
     </Border>
     <TextBlock Text="QUICK ACCESS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SkyMuted}" Margin="0,0,0,14"/>
     <UniformGrid Columns="2">
      <Border Background="{StaticResource SkySurface}" CornerRadius="10" Padding="20" Margin="0,0,10,0">
       <StackPanel><TextBlock Text="▦  VERSION LIBRARY" FontWeight="Bold"/><TextBlock Text="Browse official releases and snapshots." Foreground="{StaticResource SkyMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
      </Border>
      <Border Background="{StaticResource SkySurface}" CornerRadius="10" Padding="20" Margin="10,0,0,0">
       <StackPanel><TextBlock Text="◇  MOD MANAGER" FontWeight="Bold"/><TextBlock Text="Your mods, loaders and modpacks." Foreground="{StaticResource SkyMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
      </Border>
     </UniformGrid>
    </StackPanel>
    <StackPanel x:Name="VersionsPanel" Visibility="Collapsed">
     <TextBlock Text="MINECRAFT LIBRARY" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Versions" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Browse official Minecraft releases and snapshots. Install a version to cache its game files on this PC." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,22" TextWrapping="Wrap"/>
     <DockPanel Margin="0,0,0,14">
      <Button Content="↻  REFRESH" DockPanel.Dock="Right" Padding="14,9" Margin="10,0,0,0" Background="#24384A" Foreground="#EAF4FF" BorderBrush="#36516A" Click="RefreshVersions_Click"/>
      <ComboBox x:Name="VersionTypeFilter" Width="150" SelectedIndex="0" Margin="0,0,10,0" Padding="8,7" SelectionChanged="VersionTypeFilter_SelectionChanged">
       <ComboBoxItem Content="All versions" Tag="all"/>
       <ComboBoxItem Content="Releases" Tag="release"/>
       <ComboBoxItem Content="Snapshots" Tag="snapshot"/>
       <ComboBoxItem Content="Old beta" Tag="old_beta"/>
       <ComboBoxItem Content="Old alpha" Tag="old_alpha"/>
      </ComboBox>
      <TextBox x:Name="VersionSearchInput" Height="36" Padding="11,8" FontSize="14" Background="#1F2D3B" Foreground="#F2F7FC" BorderBrush="#36516A" VerticalContentAlignment="Center" ToolTip="Search versions, e.g. 1.20.1" TextChanged="VersionSearchInput_TextChanged"/>
     </DockPanel>
     <Border Background="{StaticResource SkySurface}" BorderBrush="#36516A" BorderThickness="1" CornerRadius="10" Padding="10">
      <ListView x:Name="VersionList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SkyText}" SelectionMode="Single" MinHeight="330" SelectionChanged="VersionList_SelectionChanged">
       <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
         <Setter Property="Padding" Value="10,12"/>
         <Setter Property="Margin" Value="0,2"/>
         <Setter Property="Background" Value="#172738"/>
         <Setter Property="BorderBrush" Value="#2D455C"/>
         <Setter Property="BorderThickness" Value="1"/>
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
             <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#244D70"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="#3D8EDB"/></Trigger>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="#5A9ED8"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </ListView.ItemContainerStyle>
       <ListView.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
          <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Foreground="{StaticResource SkyMuted}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding ReleaseDateLabel}" Foreground="{StaticResource SkyMuted}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" Foreground="#8BC4FF" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
         </Grid>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
     </Border>
     <TextBlock x:Name="VersionsMessage" Text="Connect to the internet to load Mojang's official version list." Foreground="{StaticResource SkyMuted}" Margin="2,12,0,12" TextWrapping="Wrap"/>
     <Border Background="#1F2D3B" BorderBrush="#36516A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,4,0,0">
      <StackPanel>
       <DockPanel>
        <StackPanel>
         <TextBlock Text="INSTALL SELECTED VERSION" FontSize="11" FontWeight="Bold" Foreground="#8BC4FF"/>
         <TextBlock x:Name="SelectedVersionLabel" Text="Select a version above" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
         <Button x:Name="InstallVersionButton" Content="INSTALL VERSION" Padding="17,10" Background="#3D8EDB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="InstallVersion_Click" IsEnabled="False"/>
         <Button x:Name="PlayOfflineButton" Content="▶  PLAY OFFLINE" Padding="17,10" Margin="10,0,0,0" Background="#2F7A55" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="PlayOffline_Click" IsEnabled="False" ToolTip="Launch this version with your offline profile. Enable offline mode under Settings first."/>
        </StackPanel>
       </DockPanel>
       <ProgressBar x:Name="VersionInstallProgress" Height="7" Margin="0,16,0,8" Minimum="0" Maximum="100" Visibility="Collapsed"/>
       <TextBlock x:Name="VersionInstallMessage" Foreground="{StaticResource SkyMuted}" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
     <TextBlock Text="ACCOUNT MANAGEMENT" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Profiles" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Manage offline player profiles on this PC. Each profile is a local player name used for offline launches." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,24"/>
     <Border Background="{StaticResource SkySurface}" CornerRadius="12" Padding="22" Margin="0,0,0,18">
      <StackPanel>
       <TextBlock Text="ADD OFFLINE PROFILE" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,0,0,12"/>
       <TextBlock Text="Minecraft username" Foreground="{StaticResource SkyMuted}" Margin="0,0,0,6"/>
       <DockPanel LastChildFill="False">
        <TextBox x:Name="UsernameInput" Width="260" Height="38" Padding="10,8" FontSize="14" Background="#111C28" Foreground="#F0F1E9" BorderBrush="#3C5B76" VerticalContentAlignment="Center" MaxLength="16" ToolTip="3–16 letters, numbers or underscores"/>
        <Button Content="ADD PROFILE" Margin="12,0,0,0" Padding="18,8" Background="#3D8EDB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="AddProfile_Click"/>
       </DockPanel>
       <TextBlock x:Name="ProfileMessage" Foreground="#D9B879" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <TextBlock Text="SAVED PROFILES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SkyMuted}" Margin="0,0,0,12"/>
     <ItemsControl x:Name="ProfilesList">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="#1F2D3B" BorderBrush="#36516A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
           <TextBlock Text="{Binding Username}" FontSize="17" FontWeight="Bold"/>
           <TextBlock Text="{Binding StatusLabel}" Foreground="#A8B8C8" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
           <Button Content="USE PROFILE" Padding="12,7" Margin="0,0,8,0" Click="SelectProfile_Click" Tag="{Binding Id}"/>
           <Button Content="REMOVE" Padding="12,7" Background="#49302D" Foreground="#F0D8D3" BorderThickness="0" Click="DeleteProfile_Click" Tag="{Binding Id}"/>
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <Border Background="#24384A" CornerRadius="10" Padding="16" Margin="0,10,0,0">
      <TextBlock Text="Profiles are local player identities, not Microsoft accounts. Offline launches work in singleplayer and on LAN; servers that verify accounts will reject the connection." Foreground="#D7E5F2" TextWrapping="Wrap" FontSize="12"/>
     </Border>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
     <TextBlock Text="RUNTIME MANAGEMENT" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Managed Java" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Sky Client downloads isolated Eclipse Temurin runtimes automatically, based on each Minecraft version's official metadata." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,24" TextWrapping="Wrap"/>
     <Border Background="{StaticResource SkySurface}" CornerRadius="12" Padding="22">
      <StackPanel>
       <TextBlock Text="INSTALLED RUNTIMES" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,0,0,12"/>
       <TextBlock x:Name="ManagedJavaStatus" Text="Checking managed runtimes…" Foreground="{StaticResource SkyText}" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Background="#24384A" CornerRadius="10" Padding="16" Margin="0,18,0,0">
      <TextBlock Text="Runtime selection is version-specific: older Minecraft releases may need Java 8 or 16, while modern releases declare their required Java major in Mojang metadata. Sky Client does not use or modify your system Java installation." Foreground="#D7E5F2" TextWrapping="Wrap" FontSize="12"/>
     </Border>
     <TextBlock Text="ACCOUNT &amp; LAUNCH" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,30,0,12"/>
     <TextBlock Text="Offline mode" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Offline mode lets an installed Minecraft version start without signing in. The game uses a locally generated player identity, so world saves, inventory and LAN games stay tied to the same name." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,20" TextWrapping="Wrap"/>
     <Border Background="{StaticResource SkySurface}" CornerRadius="12" Padding="22">
      <StackPanel>
       <CheckBox x:Name="OfflineModeCheckBox" Content="Enable offline mode (launch without a Microsoft account)" FontWeight="SemiBold" Foreground="{StaticResource SkyText}" Checked="OfflineMode_Changed" Unchecked="OfflineMode_Changed"/>
       <TextBlock x:Name="OfflineModeStatus" Text="Offline mode is OFF. Launching Minecraft requires a Microsoft session, which Sky Client does not support yet." Foreground="#A8B8C8" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="#24384A" CornerRadius="10" Padding="16" Margin="0,18,0,0">
      <TextBlock Text="Offline mode does not verify account ownership and does not provide skins, Realms, snapshots of your account or access to online servers that require authentication. Singleplayer and LAN play work; a legitimate Minecraft licence is still required to play." Foreground="#D7E5F2" TextWrapping="Wrap" FontSize="12"/>
     </Border>
    </StackPanel>

    <StackPanel x:Name="InstancesPanel" Visibility="Collapsed">
     <TextBlock Text="INSTANCE MANAGEMENT" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Instances" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Separate Minecraft directories for different versions, loaders, mods, configs and saves." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,22" TextWrapping="Wrap"/>
     <Border Background="{StaticResource SkySurface}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
      <StackPanel>
       <TextBlock Text="CREATE INSTANCE" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,0,0,12"/>
       <TextBox x:Name="InstanceNameInput" Height="38" Padding="10,8" Background="#111C28" Foreground="#F0F1E9" BorderBrush="#3C5B76" ToolTip="Instance name"/>
       <ComboBox x:Name="InstanceVersionSelector" Height="38" Margin="0,10,0,0" Padding="8" DisplayMemberPath="Id"/>
       <ComboBox x:Name="InstanceLoaderSelector" Height="38" Margin="0,10,0,0" SelectedIndex="0" Padding="8">
        <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
        <ComboBoxItem Content="Fabric" Tag="fabric"/>
        <ComboBoxItem Content="Forge" Tag="forge"/>
        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
        <ComboBoxItem Content="Quilt" Tag="quilt"/>
       </ComboBox>
       <Button Content="CREATE INSTANCE" HorizontalAlignment="Left" Padding="18,10" Margin="0,14,0,0" Background="#3D8EDB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="CreateInstance_Click"/>
       <TextBlock x:Name="InstanceMessage" Foreground="{StaticResource SkyMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <TextBlock Text="YOUR INSTANCES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SkyMuted}" Margin="0,0,0,10"/>
     <ListView x:Name="InstancesList" MinHeight="220" Background="{StaticResource SkySurface}" Foreground="{StaticResource SkyText}" BorderBrush="#36516A">
      <ListView.ItemTemplate><DataTemplate>
       <Grid Margin="5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding Details}" Foreground="{StaticResource SkyMuted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <TextBlock Grid.Column="1" Text="INSTANCE" Foreground="#8BC4FF" FontWeight="Bold" VerticalAlignment="Center"/>
       </Grid>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button Content="DELETE SELECTED INSTANCE" HorizontalAlignment="Left" Padding="14,9" Margin="0,12,0,0" Background="#49302D" Foreground="#F0D8D3" BorderThickness="0" Click="DeleteInstance_Click"/>
    </StackPanel>
    <StackPanel x:Name="ModsPanel" Visibility="Collapsed">
     <TextBlock Text="MODRINTH MOD MANAGER" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Mods" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Search Modrinth, filter by game version and loader, install compatible files and manage each instance's mods." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,22" TextWrapping="Wrap"/>
     <Border Background="{StaticResource SkySurface}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="TARGET INSTANCE" FontWeight="Bold" Foreground="#8BC4FF" FontSize="11" Margin="0,0,0,8"/>
       <ComboBox x:Name="ModInstanceSelector" Height="36" DisplayMemberPath="Name" SelectionChanged="ModInstanceSelector_SelectionChanged"/>
       <DockPanel Margin="0,12,0,0">
        <ComboBox x:Name="ModLoaderSelector" Width="140" SelectedIndex="0" Padding="8" DockPanel.Dock="Right">
         <ComboBoxItem Content="Fabric" Tag="fabric"/>
         <ComboBoxItem Content="Forge" Tag="forge"/>
         <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
         <ComboBoxItem Content="Quilt" Tag="quilt"/>
        </ComboBox>
        <TextBox x:Name="ModSearchInput" Height="36" Padding="10,8" Background="#111C28" Foreground="#F0F1E9" BorderBrush="#3C5B76" VerticalContentAlignment="Center" ToolTip="Search mods"/>
       </DockPanel>
       <Button Content="SEARCH MODRINTH" HorizontalAlignment="Left" Padding="16,9" Margin="0,12,0,0" Background="#3D8EDB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="SearchMods_Click"/>
       <TextBlock x:Name="ModManagerMessage" Foreground="{StaticResource SkyMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <TextBlock Text="SEARCH RESULTS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SkyMuted}" Margin="0,0,0,8"/>
     <ListView x:Name="ModSearchResults" MinHeight="190" MaxHeight="280" Background="{StaticResource SkySurface}" Foreground="{StaticResource SkyText}" BorderBrush="#36516A">
      <ListView.ItemTemplate><DataTemplate>
       <StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource SkyMuted}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding DownloadsLabel}" Foreground="#8BC4FF" FontSize="11" Margin="0,4,0,0"/></StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button Content="INSTALL SELECTED MOD" HorizontalAlignment="Left" Padding="16,9" Margin="0,10,0,16" Background="#2F7A55" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="InstallMod_Click"/>
     <TextBlock Text="INSTALLED MODS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SkyMuted}" Margin="0,0,0,8"/>
     <ListView x:Name="InstalledModsList" MinHeight="120" MaxHeight="220" Background="{StaticResource SkySurface}" Foreground="{StaticResource SkyText}" BorderBrush="#36516A" DisplayMemberPath="DisplayName"/>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="ENABLE / DISABLE" Padding="13,8" Click="ToggleMod_Click"/>
      <Button Content="REMOVE MOD" Padding="13,8" Margin="8,0,0,0" Background="#49302D" Foreground="#F0D8D3" BorderThickness="0" Click="RemoveMod_Click"/>
     </StackPanel>
    </StackPanel>
    <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed">
     <TextBlock Text="LOCAL CRASH ANALYSIS" FontSize="12" FontWeight="Bold" Foreground="#8BC4FF" Margin="0,8,0,12"/>
     <TextBlock Text="Crash diagnostics" FontSize="34" FontWeight="Bold" Margin="0,0,0,8"/>
     <TextBlock Text="Scan Minecraft instance logs and crash reports. Analysis stays on this PC; nothing is uploaded." Foreground="{StaticResource SkyMuted}" FontSize="15" Margin="0,0,0,18" TextWrapping="Wrap"/>
     <Button Content="SCAN LOGS &amp; CRASH REPORTS" HorizontalAlignment="Left" Padding="16,10" Background="#3D8EDB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="ScanDiagnostics_Click"/>
     <TextBlock x:Name="DiagnosticsMessage" Foreground="{StaticResource SkyMuted}" Margin="0,10,0,12" TextWrapping="Wrap"/>
     <ListView x:Name="CrashReportsList" MinHeight="190" MaxHeight="260" Background="{StaticResource SkySurface}" Foreground="{StaticResource SkyText}" BorderBrush="#36516A" SelectionChanged="CrashReportsList_SelectionChanged">
      <ListView.ItemTemplate><DataTemplate>
       <StackPanel Margin="4"><TextBlock Text="{Binding FileName}" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource SkyMuted}" FontSize="12"/><TextBlock Text="{Binding LastModified}" Foreground="#8BC4FF" FontSize="11"/></StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <TextBlock Text="DIAGNOSTIC DETAILS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SkyMuted}" Margin="0,14,0,8"/>
     <TextBox x:Name="CrashDiagnosticText" MinHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#111C28" Foreground="#DCE8F4" BorderBrush="#36516A" Padding="12"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>